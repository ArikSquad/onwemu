{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "dnf install -y rust cargo lld rust-std-static-wasm32-unknown-unknown && npm ci --include=dev",
  "buildCommand": "PATH=/usr/bin:$PATH npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "headers": [{ "source": "/pkg/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] }]
}
